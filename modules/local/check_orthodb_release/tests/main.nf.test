nextflow_process {

    name "Test Process CHECK_ORTHODB_RELEASE"
    script "modules/local/check_orthodb_release/main.nf"
    process "CHECK_ORTHODB_RELEASE"
    tag "module"
    tag "check_orthodb_release"
    tag "ci"

    test("Should refuse a database built from a different OrthoDB release") {

        when {
            process {
                """
                input[0] = "\$projectDir/tests/reference_databases/mock_orthodb_stale.duckdb"
                """
            }
        }

        then {
            //   the cluster ids the API hands out would silently mean something else
            assert process.failed
            assert process.errorReport.contains("OrthoDB release mismatch")
        }

    }

}
