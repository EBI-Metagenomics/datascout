nextflow_process {

    name "Test Process ORTHODB_GETDB"
    script "modules/local/orthodb_getdb/main.nf"
    process "ORTHODB_GETDB"
    tag "module"
    tag "orthodb_getdb"
    tag "ci"

    //   built from a miniature dump rather than the real 39 GB one, which still exercises the
    //   fifo the fasta is read through and the release recorded in the database
    test("Should build a database from dump files already on disk") {

        when {
            params {
                orthodb_db_dir = "${outputDir}/orthodb_db"
            }
            process {
                """
                input[0] = "v12"
                input[1] = "v12.2"
                input[2] = "\$projectDir/tests/reference_databases/odb12v2_OG2genes.tab.gz"
                input[3] = "\$projectDir/tests/reference_databases/odb12v2_og_aa_fasta.gz"
                """
            }
        }

        then {
            assert process.success
            assert file(process.out.orthodb_db.get(0)).exists()
            //   the release comes from the dump file names, so BUILD_ORTHODB_FASTA can report it
            assert file(process.out.versions.get(0)).text.contains("OrthoDB: odb12v2")
        }

    }

}
