nextflow_process {

    name "Test Process RESOLVE_ORTHODB_TAXON"
    script "modules/local/resolve_orthodb_taxon/main.nf"
    process "RESOLVE_ORTHODB_TAXON"
    tag "module"
    tag "resolve_orthodb_taxon"
    tag "ci"

    test("Should resolve a taxon and list its clusters") {

        when {
            process {
                """
                input[0] = tuple([id:"test_sample1", genome_id:"GCA_003719455.1", ena_tax:"default"], "$projectDir/tests/reference_databases/test_sample1_tax_ranks.tsv", "default")
                input[1] = 1
                input[2] = "v12.2"
                """
            }
        }

        then {
            assert process.success
            assert process.out.taxon_clusters.size() == 1
            def taxon_file = file(process.out.taxon_clusters.get(0).get(1))
            def clusters_file = file(process.out.taxon_clusters.get(0).get(2))
            assert taxon_file.text.trim() ==~ /\d+/
            assert clusters_file.readLines().size() >= 2 // header + at least one cluster
        }

    }

}
