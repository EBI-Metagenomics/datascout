nextflow_process {

    name "Test Process ORTHODB_RELEASE"
    script "modules/local/orthodb_release/main.nf"
    process "ORTHODB_RELEASE"
    tag "module"
    tag "orthodb_release"
    tag "ci"

    test("Should write the release the pinned OrthoDB version resolves to") {

        when {
            process {
                """
                input[0] = "v12"
                """
            }
        }

        then {
            assert process.success
            //   the release names the directory ORTHODB_GETDB builds into
            assert file(process.out.release.get(0)).text.trim() ==~ /v12(\.\d+)?/
            assert file(process.out.versions.get(0)).text.contains("OrthoDB: v12")
        }

    }

}
