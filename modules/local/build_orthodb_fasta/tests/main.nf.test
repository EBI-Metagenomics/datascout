nextflow_process {

    name "Test Process BUILD_ORTHODB_FASTA"
    script "modules/local/build_orthodb_fasta/main.nf"
    process "BUILD_ORTHODB_FASTA"
    tag "module"
    tag "build_orthodb_fasta"

    test("Should write the combined FASTA of the taxon from the local OrthoDB database") {

        when {
            process {
                """
                input[0] = tuple("5204", file("$projectDir/tests/reference_databases/mock_orthodb_clusters.tsv"))
                input[1] = "$projectDir/tests/reference_databases/mock_orthodb.duckdb"
                """
            }
        }

        then {
            assert process.success
            assert process.out.fasta.get(0).get(0) == "5204"
            def fasta = file(process.out.fasta.get(0).get(1))
            assert fasta.name == "combined_orthodb_5204.faa"
            assert fasta.text.startsWith(">")
            //   the three genes of the two clusters in the mock cluster list, and nothing else
            assert fasta.text.count(">") == 3
            assert !fasta.text.contains("5691_0:000001")
        }

    }

}
